{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corgi-verse/dotsys/interop/corgipanels/panel.schema.json",
  "title": "CorgiPanels private portable reference 0.1",
  "$comment": "Copyright 2026 Hayden Lindley. SPDX-License-Identifier: Apache-2.0. Proposals are data, never grants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "panelId", "ownerId", "projectId", "revision", "eventSequence", "title", "author", "mode", "tiles", "assets"],
  "properties": {
    "version": {"const": "corgipanel/0.1"},
    "panelId": {"$ref": "#/$defs/id"},
    "ownerId": {"$ref": "#/$defs/id"},
    "projectId": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "eventSequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "title": {"$ref": "#/$defs/title"},
    "author": {"enum": ["chatgpt", "zekechat", "owner", "other"]},
    "mode": {"enum": ["connected", "reference_only"]},
    "tiles": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/tile"}},
    "assets": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["label", "uri", "revision"],
      "properties": {
        "label": {"$ref": "#/$defs/title"},
        "uri": {"type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "label", "operation", "resource"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "label": {"$ref": "#/$defs/title"},
        "operation": {"enum": ["read", "create", "write", "publish", "delete", "install", "spend"]},
        "resource": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "tile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "state", "dependsOn", "references", "actions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/title"},
        "state": {"enum": ["ready", "waiting", "running", "verifying", "complete", "failed", "unknown", "cancelled", "reference_only"]},
        "summary": {"type": "string", "maxLength": 1000},
        "dependsOn": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "references": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/reference"}},
        "actions": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/action"}}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["path", "mediaType", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"},
        "mediaType": {"enum": ["image/png", "image/jpeg", "image/webp", "text/markdown"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 10485760}
      }
    }
  }
}
